{
  "process": ["normal", "test"],
  "eventData": {
    "eventType": "contract",
    "Lead": {
      "Deal_Name": { "type": "string", "alias": "lead_name" },
      "Email": { "type": "string", "alias": "lead_email" },
      "Phone": { "type": "string", "alias": "lead_phone" }
    },
    "Call": {
      "Language": { "type": "string", "alias": "preferred_language" },
      "Best_Call_Time": { "type": "string", "alias": "call_schedule" }
    },
    "Deal": {
      "Deal_Name": { "type": "string", "alias": "deal_name" },
      "Email": { "type": "string", "alias": "deal_email" },
      "Phone": { "type": "string", "alias": "deal_phone" }
    },
    "Offer": {
      "price": { "type": "number", "alias": "offer_price" },
      "extra_costs": { "type": "number", "alias": "offer_extra_costs" }
    },
    "Contract": {
      "terms": { "type": "string", "alias": "contract_terms" },
      "value": { "type": "string", "alias": "contract_value" },
      "signed": { "type": "boolean", "alias": "is_signed" }
    },
    "Battery": {
      "price": { "type": "number", "alias": "battery_price" }
    },
    "Charger": {
      "price": { "type": "number", "alias": "charger_price" }
    }
  }
}
