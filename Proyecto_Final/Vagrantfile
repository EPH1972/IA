# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Windows 7 VM para StarCraft: Brood War 1.16.1
# · Arranca desde la ISO de Windows 7 para instalar el SO
# · La ISO de StarCraft queda montada en la segunda unidad DVD lista para instalar
#
# COMANDOS HABITUALES:
#   vagrant up       → encender / crear la VM
#   vagrant halt     → apagar
#   vagrant destroy  → eliminar la VM (el disco win7-install.vdi queda intacto)

WIN7_ISO = File.expand_path("en_windows_7_ultimate_with_sp1_x64_dvd_u_677332.iso", __dir__).freeze
SC_ISO   = File.expand_path("Starcraft Full Español.ISO",                           __dir__).freeze
VDI_PATH = File.expand_path("win7-install.vdi",                                    __dir__).freeze

abort "ERROR: ISO de Windows 7 no encontrada en #{WIN7_ISO}" unless File.exist?(WIN7_ISO)
abort "ERROR: ISO de StarCraft no encontrada en #{SC_ISO}"   unless File.exist?(SC_ISO)

Vagrant.configure("2") do |config|

  # ── Box ─────────────────────────────────────────────────────────────────────
  config.vm.box          = "win7-lite"
  config.vm.communicator = "none"   # Vagrant 2.x built-in: no SSH/WinRM, no GuestAdditions
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # ── Red ─────────────────────────────────────────────────────────────────────
  config.vm.network "public_network", bridge: "Realtek PCIe GbE Family Controller #2"
  # Port-forward para TorchCraft ZMQ: host:11111 → guest:11111 (via adaptador NAT nic1)
  config.vm.network "forwarded_port", guest: 11111, host: 11111, host_ip: "127.0.0.1", adapter: 1

  # ── VirtualBox ──────────────────────────────────────────────────────────────
  config.vm.provider "virtualbox" do |vb|
    vb.name   = "Win7-StarCraft"
    vb.gui    = true
    vb.memory = 8192
    vb.cpus   = 4

    # Gráficos – VBoxVGA es el más compatible con DirectDraw (SC 1.16.1 no usa Direct3D)
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vboxvga"]
    vb.customize ["modifyvm", :id, "--vram",               "128"]

    # Audio
    vb.customize ["modifyvm", :id, "--audio",    "dsound"]
    vb.customize ["modifyvm", :id, "--audioout", "on"]
    vb.customize ["modifyvm", :id, "--audioin",  "off"]

    # Rendimiento
    vb.customize ["modifyvm", :id, "--ioapic",       "on"]
    vb.customize ["modifyvm", :id, "--hwvirtex",     "on"]
    vb.customize ["modifyvm", :id, "--nestedpaging", "on"]
    vb.customize ["modifyvm", :id, "--vtxvpid",      "on"]
    vb.customize ["modifyvm", :id, "--pae",          "on"]

    vb.customize ["modifyvm", :id, "--clipboard-mode", "bidirectional"]
    vb.customize ["modifyvm", :id, "--mouse", "ps2"]

    # ── Carpeta compartida para instaladores (BWAPI, TorchCraft.dll, etc.) ───
    # Dentro de la VM (con Guest Additions): \\vboxsvr\sc1_files
    # o como unidad automática (E:\ / F:\) si --automount está activo
    HOST_SHARE = File.expand_path(".", __dir__)
    vb.customize ["sharedfolder", "add", :id,
      "--name",      "sc1_files",
      "--hostpath",  HOST_SHARE,
      "--automount",
      "--auto-mount-point", "S:"]

    # Orden de arranque: DVD primero (instala Windows), luego disco duro
    vb.customize ["modifyvm", :id, "--boot1", "dvd"]
    vb.customize ["modifyvm", :id, "--boot2", "disk"]
    vb.customize ["modifyvm", :id, "--boot3", "none"]
    vb.customize ["modifyvm", :id, "--boot4", "none"]

    # ── Primera ejecución: crear y conectar el disco duro ───────────────────
    unless File.exist?(VDI_PATH)
      vb.customize ["createmedium", "disk",
        "--filename", VDI_PATH,
        "--size",     "51200",
        "--format",   "VDI"]

      # Desconectar el disco mínimo del box dummy
      vb.customize ["storageattach", :id,
        "--storagectl", "IDE Controller",
        "--port", "0", "--device", "0",
        "--type", "hdd", "--medium", "none"]

      # Conectar disco real de 50 GB
      vb.customize ["storageattach", :id,
        "--storagectl", "IDE Controller",
        "--port", "0", "--device", "0",
        "--type", "hdd", "--medium", VDI_PATH]
    end

    # ── Siempre: montar las ISOs en los slots DVD ────────────────────────────
    vb.customize ["storageattach", :id,
      "--storagectl", "IDE Controller",
      "--port", "1", "--device", "0",
      "--type", "dvddrive", "--medium", "emptydrive"]

    vb.customize ["storageattach", :id,
      "--storagectl", "IDE Controller",
      "--port", "1", "--device", "1",
      "--type", "dvddrive", "--medium", SC_ISO]
  end

  # ── Trigger pre-up: elimina la carpeta compartida si ya existe ───────────────
  config.trigger.before :up do |t|
    t.name = "Limpiar shared folder preexistente"
    t.ruby do |_env, _machine|
      system('"C:/Program Files/Oracle/VirtualBox/VBoxManage.exe" sharedfolder remove "Win7-StarCraft" --name sc1_files 2>nul')
      true
    end
  end

  # ── Trigger post-destroy ─────────────────────────────────────────────────────
  config.trigger.after :destroy do |t|
    t.name = "Aviso post-destroy"
    t.ruby do |_env, _machine|
      puts ""
      puts "VM eliminada. El disco win7-install.vdi se conserva."
      puts "Bórralo manualmente si quieres una instalación completamente limpia."
    end
  end

  # ── Mensaje post-arranque ────────────────────────────────────────────────────
  config.vm.post_up_message = <<~MSG

    ┌──────────────────────────────────────────────────────────┐
    │          Windows 7 – StarCraft VM iniciada               │
    ├──────────────────────────────────────────────────────────┤
    │  Interactúa desde la ventana de VirtualBox.              │
    │                                                          │
    │  PRIMERA VEZ:                                            │
    │  1. Instala Windows 7 desde el DVD que arranca           │
    │  2. Instala VirtualBox Guest Additions                   │
    │  3. La ISO de StarCraft ya está en D: o E:               │
    │     Ejecútala desde dentro de Windows para instalar      │
    │                                                          │
    │  CARPETA COMPARTIDA (requiere Guest Additions):          │
    │  · Unidad S:\  (o \\vboxsvr\sc1_files)                  │
    │  · Contiene los instaladores del proyecto host           │
    │  · Desde ahí instala BWAPI, copia TorchCraft.dll, etc.  │
    │                                                          │
    │  vagrant halt    → apagar la VM                          │
    │  vagrant up      → encenderla de nuevo                   │
    │  vagrant destroy → eliminar la VM                        │
    └──────────────────────────────────────────────────────────┘

  MSG

end
